  (text "ESP32-S3-DevKitC-1 in 2x22 sockets (hand-soldered). ADC1 GPIO1-10 all used (pots, IS currents,\nbus, 12 V). GPIO19/20 used -> program via the \"UART\" USB port. GPIO35-37 free (octal PSRAM on\nR8 variants), GPIO38/48 = on-board RGB LED."
    (at 15.24 28.04 0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left bottom))
    (uuid "785456d0-0038-5b24-bd6b-c42649be2472"))
