<?xml version="1.0"?>
<robot name="solbot5" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:arg name="namespace" default=""/>
<xacro:include filename="$(find description)/urdf/solbot3_steering_hinge.xacro" />
<xacro:include filename="$(find description)/urdf/limo_xacro.xacro" />
    <!-- Variables -->
    <xacro:property name="M_PI" value="3.14159"/>

  <!-- Define robot constants -->
  <xacro:property name="base_width" value="0.77"/>
  <xacro:property name="base_length" value="1.20"/>
  <xacro:property name="base_height" value="0.20"/>

  <xacro:property name="wheel_radius" value="0.20"/>
  <xacro:property name="wheel_width" value="0.10"/>
  <xacro:property name="wheel_ygap" value="0.025"/>
  <xacro:property name="wheel_zoff" value="0.76"/>
  <xacro:property name="wheel_xoff" value="0.60"/>

  <xacro:property name="caster_xoff" value="2.00"/>

    <xacro:property name="wheelbase" value="1.30"/>
    <xacro:property name="track" value="0.77"/>
    <xacro:property name="wheel_vertical_offset" value="-0.76" />
    <xacro:property name="wheel_length" value="0.001" />
    <xacro:property name="wheel_radius" value="0.20" />

  <!-- Define inertial property macros  -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy = "0" ixz = "0" iyy="${(m/12) * (3*r*r + h*h)}" iyz = "0" izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0" iyy="${(2/5) * m * (r*r)}" iyz="0.0" izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Robot Footprint -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="Cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="15" w="${base_width}" d="${base_length}" h="${base_height}"/>
  </link>

  <!-- base_footprint is at the rear axle centre (Ackermann pivot, RS planning reference).
       base_link (chassis box) centre is wheelbase/2 = 0.60m ahead of the rear axle.
       Wheel joints at ±wheelbase/2 from base_link → axle-to-axle = wheelbase = 1.20m,
       consistent with the AckermannSteering plugin wheel_base parameter. -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="${wheelbase/2} 0.0 ${(wheel_radius+wheel_zoff)}" rpy="0 0 0"/>
  </joint>

  <xacro:limo_left_steering_hinge parent_prefix="base_link" wheel_prefix="front_left">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0  0" />
  </xacro:limo_left_steering_hinge>

  <xacro:limo_right_steering_hinge parent_prefix="base_link" wheel_prefix="front_right">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0" />
  </xacro:limo_right_steering_hinge>

    <xacro:limo_wheel parent_prefix="base_link" wheel_prefix="rear_left" reflect="1" fixed_on="false">
        <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
    </xacro:limo_wheel>

    <xacro:limo_wheel parent_prefix="base_link" wheel_prefix="rear_right" reflect="-1" fixed_on="false">
        <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0" />
    </xacro:limo_wheel>

<!--              "imu_link"                  -->    
<link name="imu_link">
  <visual>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </collision>

  <xacro:box_inertia m="0.1" w="0.1" d="0.1" h="0.1"/>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0 0 0.01"/>
</joint>

 <gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>imu_gazebo</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.01</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.01</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.01</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
  </sensor>
</gazebo>

<!--              "gps_link"                  -->    
<link name="gps_link">
  <visual>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </collision>

  <xacro:box_inertia m="0.1" w="0.1" d="0.1" h="0.1"/>
</link>

<joint name="gps_joint" type="fixed">
  <parent link="base_link"/>
  <child link="gps_link"/>
  <origin xyz="${wheelbase/2 + 0.35} 0 0.01"/>
</joint>

 <gazebo reference="gps_link">
  <sensor name="navsat" type="navsat">
    <always_on>true</always_on>
    <update_rate>10</update_rate>
    <topic>$(arg namespace)/gps/fix</topic>
    <gz_frame_id>gps_link</gz_frame_id>
    <navsat>
      <position_sensing>
        <horizontal>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </horizontal>
        <vertical>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </vertical>
      </position_sensing>
    </navsat>
  </sensor>
</gazebo>

<!--              "gps_rear_link"                  -->
<link name="gps_rear_link">
  <visual>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </collision>

  <xacro:box_inertia m="0.1" w="0.1" d="0.1" h="0.1"/>
</link>

<joint name="gps_rear_joint" type="fixed">
  <parent link="base_link"/>
  <child link="gps_rear_link"/>
  <origin xyz="${-(wheelbase/2 + 0.35)} 0 0.01"/>
</joint>

<gazebo reference="gps_rear_link">
  <sensor name="navsat_rear" type="navsat">
    <always_on>true</always_on>
    <update_rate>10</update_rate>
    <topic>$(arg namespace)/gps_rear/fix</topic>
    <gz_frame_id>gps_rear_link</gz_frame_id>
    <navsat>
      <position_sensing>
        <horizontal>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </horizontal>
        <vertical>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </vertical>
      </position_sensing>
    </navsat>
  </sensor>
</gazebo>

<!--              tool_link                  -->
<!-- tool_link coincides with base_footprint (both at the rear axle centre).
     Kept as an alias so RS planner / controller configs using tool_link still work. -->
<link name="tool_link"/>

<joint name="tool_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="tool_link"/>
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
</joint>

<!--              tool_bar                   -->
<!-- Laterally sliding toolbar, centred on tool_link.
     In simulation the dynamic TF (tool_link → tool_bar) is broadcast by
     tool_actuator_sim; this static joint is the zero-position fallback for
     robot_state_publisher when the sim nodes are not running. -->
<link name="tool_bar">
  <visual>
    <geometry>
      <box size="0.05 0.80 0.05"/>
    </geometry>
    <material name="tool_bar_color">
      <color rgba="0.8 0.4 0.0 1.0"/>
    </material>
  </visual>
  <collision>
    <geometry>
      <box size="0.05 0.80 0.05"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="3.0"/>
    <inertia ixx="0.016" ixy="0.0" ixz="0.0"
             iyy="0.001" iyz="0.0" izz="0.016"/>
  </inertial>
</link>

<joint name="tool_bar_joint" type="prismatic">
  <parent link="tool_link"/>
  <child link="tool_bar"/>
  <origin xyz="0.6 0.0 0.4" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="-0.10" upper="0.10" effort="100" velocity="0.5"/>
</joint>

<!--              implements (3 × red tines on tool_bar)           -->
<link name="implement_center">
  <visual>
    <geometry><box size="0.03 0.02 0.01"/></geometry>
    <material name="implement_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
  </visual>
  <collision><geometry><box size="0.03 0.02 0.01"/></geometry></collision>
  <inertial>
    <mass value="0.5"/>
    <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
  </inertial>
</link>
<joint name="implement_center_joint" type="fixed">
  <parent link="tool_bar"/>
  <child link="implement_center"/>
  <origin xyz="-0.20 0.0 0.0" rpy="0 0 0"/>
</joint>

<link name="implement_left">
  <visual>
    <geometry><box size="0.03 0.02 0.01"/></geometry>
    <material name="implement_red"/>
  </visual>
  <collision><geometry><box size="0.03 0.02 0.01"/></geometry></collision>
  <inertial>
    <mass value="0.5"/>
    <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
  </inertial>
</link>
<joint name="implement_left_joint" type="fixed">
  <parent link="tool_bar"/>
  <child link="implement_left"/>
  <origin xyz="-0.20 0.36 0.0" rpy="0 0 0"/>
</joint>

<link name="implement_right">
  <visual>
    <geometry><box size="0.03 0.02 0.01"/></geometry>
    <material name="implement_red"/>
  </visual>
  <collision><geometry><box size="0.03 0.02 0.01"/></geometry></collision>
  <inertial>
    <mass value="0.5"/>
    <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
  </inertial>
</link>
<joint name="implement_right_joint" type="fixed">
  <parent link="tool_bar"/>
  <child link="implement_right"/>
  <origin xyz="-0.20 -0.36 0.0" rpy="0 0 0"/>
</joint>

<!--              OAK-D Lite camera           -->
<!-- Forward-facing, mounted on base_link 50 cm above ground centre,
     pointing straight down toward the crop rows.
     Gazebo RGBD sensor simulates the RGB stream used by plant_row_detector_sim. -->
<link name="oakd_link">
  <visual>
    <geometry>
      <box size="0.036 0.091 0.028"/>
    </geometry>
    <material name="oakd_color">
      <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
  </visual>
  <collision>
    <geometry>
      <box size="0.036 0.091 0.028"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="0.061"/>
    <inertia ixx="0.000020" ixy="0.0" ixz="0.0"
             iyy="0.000153" iyz="0.0" izz="0.000161"/>
  </inertial>
</link>

<!-- Camera is 0.5m forward and 0.9m above rear axle, pointing straight down. -->
<joint name="oakd_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="oakd_link"/>
  <origin xyz="0.5 0.0 0.80" rpy="0 ${M_PI/2} 0"/>
</joint>

<!-- Optical frame: ROS camera convention (z forward, x right, y down) -->
<link name="oakd_rgb_optical_frame"/>
<joint name="oakd_rgb_optical_joint" type="fixed">
  <parent link="oakd_link"/>
  <child link="oakd_rgb_optical_frame"/>
  <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
</joint>

<gazebo reference="oakd_link">
  <sensor name="oakd_rgb" type="rgbd_camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <camera>
      <!-- OAK-D Lite RGB: 81° HFOV -->
      <horizontal_fov>1.414</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>10.0</far>
      </clip>
      <optical_frame_id>oakd_rgb_optical_frame</optical_frame_id>
    </camera>
    <topic>oakd/rgb</topic>
    <visualize>false</visualize>
  </sensor>
</gazebo>

    <!--              ackermann plugin                 -->
  <gazebo>
      <plugin
        filename="gz-sim-ackermann-steering-system"
        name="gz::sim::systems::AckermannSteering">
        <left_joint>front_left_wheel</left_joint>
        <left_joint>rear_left_wheel</left_joint>
        <right_joint>front_right_wheel</right_joint>
        <right_joint>rear_right_wheel</right_joint>
        <left_steering_joint>front_left_steering</left_steering_joint>
        <right_steering_joint>front_right_steering</right_steering_joint>
        <kingpin_width>${track}</kingpin_width>
        <steering_limit>0.610865</steering_limit>
        <wheel_base>1.33</wheel_base>
        <wheel_separation>${track}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <min_velocity>-5</min_velocity>
        <max_velocity>5</max_velocity>
        <min_acceleration>-3</min_acceleration>
        <max_acceleration>3</max_acceleration>
        <steer_p_gain>100</steer_p_gain>
        <topic>cmd_vel_ackermann</topic>


        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>

      </plugin>

      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>rear_left_wheel</joint_name>
        <joint_name>rear_right_wheel</joint_name>
        <joint_name>front_left_wheel</joint_name>
        <joint_name>front_right_wheel</joint_name>
        <joint_name>front_left_steering</joint_name>
        <joint_name>front_right_steering</joint_name>
        <joint_name>tool_bar_joint</joint_name>
        <topic>joint_states</topic>
        <update_rate>30</update_rate>
      </plugin>

      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>tool_bar_joint</joint_name>
        <topic>/tool_bar_joint/cmd_pos</topic>
        <p_gain>100</p_gain>
        <i_gain>0</i_gain>
        <d_gain>10</d_gain>
      </plugin>

  </gazebo>
</robot>