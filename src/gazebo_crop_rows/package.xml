<?xml version="1.0"?>
<package format="3">
  <name>gazebo_crop_rows</name>
  <version>0.1.0</version>
  <description>Spawns and removes crop row models in Gazebo around the robot's current map-frame position.</description>
  <maintainer email="lkowale@gmail.com">lkowale</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_pep8</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
