<?xml version="1.0"?>
<package format="3">
  <name>gazebo_crop_rows</name>
  <version>0.2.0</version>
  <description>Spawns and removes crop row models in Gazebo around the robot's current map-frame position.</description>
  <maintainer email="lkowale@gmail.com">lkowale</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
